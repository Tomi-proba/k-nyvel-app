# Másolja .env néven, és szükség szerint módosítsa.

# Az alkalmazás futás közbeni kapcsolata (korlátozott jogú felhasználó).
DATABASE_URL=postgresql://konyvelo_app:konyvelo_app@localhost:5432/konyvelo
# A migrációk a séma tulajdonosaként futnak.
DATABASE_MIGRATION_URL=postgresql://konyvelo_owner:konyvelo_owner@localhost:5432/konyvelo

# Automata tesztek adatbázisa (a tesztek minden futáskor újraépítik!).
TEST_DATABASE_URL=postgresql://konyvelo_app:konyvelo_app@localhost:5432/konyvelo_test
TEST_DATABASE_MIGRATION_URL=postgresql://konyvelo_owner:konyvelo_owner@localhost:5432/konyvelo_test

# A mentés visszaállításának tesztje ide állítja vissza a teszt-adatbázis mentését (a tesztek törlik).
RESTORE_TEST_DATABASE_URL=postgresql://konyvelo_app:konyvelo_app@localhost:5432/konyvelo_restore_test
RESTORE_TEST_DATABASE_MIGRATION_URL=postgresql://konyvelo_owner:konyvelo_owner@localhost:5432/konyvelo_restore_test

PORT=3000
HOST=127.0.0.1
# Éles üzemben (HTTPS mögött) true; fejlesztéskor false.
COOKIE_SECURE=false
# Munkamenet lejárata tétlenség esetén, percben.
SESSION_IDLE_MINUTES=720
# Ha fordított proxy (pl. nginx) mögött fut: true
TRUST_PROXY=false
# További engedélyezett böngészőcímek, vesszővel (pl. GitHub Codespaces címe); üresen csak a saját cím.
ALLOWED_ORIGINS=

# Böngészős (végponttól végpontig) tesztek adatbázisa – minden futáskor újraépül!
E2E_DATABASE_URL=postgresql://konyvelo_app:konyvelo_app@localhost:5432/konyvelo_e2e
E2E_DATABASE_MIGRATION_URL=postgresql://konyvelo_owner:konyvelo_owner@localhost:5432/konyvelo_e2e

# NAV Online Számla import (7. lépés) az eÁFA NAV-átjáróján keresztül. A Könyvelőben NAV-titok nincs.
# Az eÁFA címe és a közös titok (ugyanaz, mint az eÁFA EAFA_KONYVELO_ATJARO_TITOK változója, legalább
# 32 karakter). Üresen a NAV-import nem érhető el. NAV-hívás csak az eÁFA főkapcsolójával mehet ki.
EAFA_ATJARO_URL=
EAFA_KONYVELO_ATJARO_TITOK=

# Csatolmányok (beszkennelt számla PDF-je, képe) tárolása. Alapból helyi mappa; később S3-kompatibilis
# tároló (pl. Supabase Storage) beállítással, kódmódosítás nélkül (lásd az AWEBOLDAL ELESITES.md-t).
FAJLTAR=local
FAJLTAR_MAPPA=
# FAJLTAR=s3
# FAJLTAR_S3_VEGPONT=https://<projekt>.supabase.co/storage/v1/s3
# FAJLTAR_S3_REGIO=eu-central-1
# FAJLTAR_S3_VODOR=konyvelo-csatolmanyok
# FAJLTAR_S3_KULCS=
# FAJLTAR_S3_TITOK=
# Egy csatolmány legnagyobb mérete (MB).
CSATOLMANY_MAX_MB=10

# Integrációs központ (I2, TERV.md F14). Ha üres, nincs integráció: a Könyvelő önállóan működik.
# A titok ugyanaz, mint a központban a KOZPONT_KONYVELO_TITOK (legalább 32 karakter; openssl rand -hex 32).
# KOZPONT_URL=http://127.0.0.1:3200
# KOZPONT_TITOK=
# A többi modul felületének címe a „honnan jött?” linkekhez (a közös felület elkészültéig).
# KESZLET_URL=
# EAFA_URL=
