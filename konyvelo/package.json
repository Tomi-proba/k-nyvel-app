{
  "name": "konyvelo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm run dev -w @konyvelo/api\" \"npm run dev -w @konyvelo/web\"",
    "build": "npm run build -w @konyvelo/web",
    "start": "npm run start -w @konyvelo/api",
    "db:setup": "tsx scripts/db-setup.ts",
    "db:migrate": "npm run migrate -w @konyvelo/api",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test -w @konyvelo/domain && npm run test -w @konyvelo/shared && npm run test -w @konyvelo/api",
    "test:e2e": "npm run build && playwright test",
    "backup": "tsx scripts/backup.ts",
    "restore": "tsx scripts/restore.ts",
    "export:check": "tsx scripts/export-check.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "1.56.1",
    "@types/node": "^22.18.0",
    "concurrently": "^9.2.1",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "vitest": "^4.1.12",
    "vite": "^7.3.7"
  },
  "engines": {
    "node": ">=22"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
