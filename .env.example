# PostgreSQL kapcsolat
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/knyvel?schema=public"

# NextAuth
AUTH_SECRET="change-me-to-a-random-32-byte-string"
NEXTAUTH_URL="http://localhost:3000"

# Fájltárolás: "local" (fejlesztéshez, ./storage mappa) vagy "s3" (Cloudflare R2 / S3-kompatibilis, éles környezet)
STORAGE_DRIVER="local"
LOCAL_STORAGE_DIR="./storage"

# S3 / Cloudflare R2 beállítások (csak ha STORAGE_DRIVER=s3)
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_BASE_URL=""

# OCR szolgáltató: "mock" fejlesztéshez, vagy "google-document-ai" éles használatra
OCR_PROVIDER="mock"

# Google Document AI beállítások (csak ha OCR_PROVIDER=google-document-ai)
# Lásd a README "Valódi OCR bekötése (Google Document AI)" szakaszát a lépésekért.
GOOGLE_CLOUD_PROJECT_ID=""
GOOGLE_DOCUMENT_AI_LOCATION="eu"
GOOGLE_DOCUMENT_AI_PROCESSOR_ID=""
# A teljes service account kulcs JSON tartalma egy sorban (opcionális — ha
# üresen hagyod, a Google Application Default Credentials láncot használja).
GOOGLE_APPLICATION_CREDENTIALS_JSON=""
